# Set true only for the local interactive demo. Mock results are disabled otherwise.
DEMO_MODE=true

# Add the server-side API key. The API base URL defaults to the official platform URL.
DETECTIFAI_API_KEY=
DETECTIFAI_API_BASE_URL=https://platform.detectif.ai/v1
# Optional per-endpoint overrides. Leave blank to use the documented defaults.
DETECTIFAI_DEEPFAKE_API_URL=
DETECTIFAI_SPEAKER_ENROLL_API_URL=
DETECTIFAI_SPEAKER_VERIFY_API_URL=

# App review thresholds; DetectifAI also returns its model threshold with each result.
DEEPFAKE_CONFIDENCE_THRESHOLD=0.62
SPEAKER_MATCH_THRESHOLD=0.53
MANUAL_REVIEW_MARGIN=0.08
